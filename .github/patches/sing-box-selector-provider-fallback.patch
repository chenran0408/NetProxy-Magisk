diff --git a/protocol/group/selector_provider_fallback_test.go b/protocol/group/selector_provider_fallback_test.go
new file mode 100644
--- /dev/null
+++ b/protocol/group/selector_provider_fallback_test.go
@@ -0,0 +1,59 @@
+package group
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func TestSelectorProviderRemovalKeepsAUsableRoute(t *testing.T) {
+	node := func(kind, tag string) adapter.Outbound {
+		return &startupTestOutbound{Adapter: outbound.NewAdapter(kind, tag, []string{N.NetworkTCP}, nil)}
+	}
+	a, b := node(C.TypeHTTP, "Provider/A"), node(C.TypeHTTP, "Provider/B")
+	block, direct := node(C.TypeBlock, "block"), node(C.TypeDirect, "direct")
+	auto := &URLTest{
+		Adapter: outbound.NewAdapter(C.TypeURLTest, "Auto", nil, []string{"block"}),
+		group:   &URLTestGroup{history: urltest.NewHistoryStorage(), interruptGroup: interrupt.NewGroup()},
+	}
+	auto.group.replaceOutbounds([]adapter.Outbound{block, b})
+	outbounds := map[string]adapter.Outbound{b.Tag(): b, block.Tag(): block, direct.Tag(): direct, auto.Tag(): auto}
+	dependencies := []string{block.Tag(), direct.Tag(), auto.Tag()}
+	selector := &Selector{Adapter: outbound.NewAdapter(C.TypeSelector, "", nil, dependencies), defaultTag: block.Tag()}
+
+	for _, test := range []struct {
+		name     string
+		previous adapter.Outbound
+		members  []string
+		want     adapter.Outbound
+	}{
+		{"initial selection", nil, nil, block},
+		{"remaining Auto members", a, []string{b.Tag()}, auto},
+		{"no members", a, nil, block},
+		{"keep manual node", b, []string{b.Tag()}, b},
+		{"keep explicit block", block, []string{b.Tag()}, block},
+		{"keep explicit direct", direct, []string{b.Tag()}, direct},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			selector.selected.Store(test.previous)
+			got, err := selector.outboundSelect(outbounds, dependencies, test.members)
+			if err != nil {
+				t.Fatal(err)
+			}
+			assertSelected(t, test.want, got)
+		})
+	}
+
+	auto.group.replaceOutbounds([]adapter.Outbound{block})
+	selector.selected.Store(a)
+	got, err := selector.outboundSelect(outbounds, dependencies, []string{b.Tag()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertSelected(t, b, got)
+}
